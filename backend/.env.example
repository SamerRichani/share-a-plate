# Copy of the settings the backend needs. The real file is backend/.env,
# which is NOT committed to Git (see .gitignore).
# `npm run setup` (from the project root) creates it for you with a random JWT_SECRET.

PORT=5001

# Local PostgreSQL connection. Put your own database password in backend/.env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=shareaplate
PGUSER=shareaplate_app
PGPASSWORD=

# Key used to sign login tokens. Must be long and random, and never shared.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Demo accounts created by `npm run db:seed`. These are local demo values only:
# use different passwords on a deployed site.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=admin123@123
DEMO_DONOR_EMAIL=donor@example.test
DEMO_DONOR_PASSWORD=donor123@123
DEMO_RECIPIENT_EMAIL=recipient@example.test
DEMO_RECIPIENT_PASSWORD=recipient123@123
